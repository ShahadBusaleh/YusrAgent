# Copy to .env and fill in local values.
# API:  uvicorn app.api.main:app --reload
# UI:   streamlit run app/ui/streamlit_app.py

SQLITE_PATH=agentic_hr.db

JWT_SECRET=replace-with-a-long-random-dev-secret
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

API_BASE_URL=http://127.0.0.1:8000

QDRANT_URL=https://YOUR-CLUSTER.qdrant.io
QDRANT_API_KEY=
QDRANT_COLLECTION=yusor_policies
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# OpenAI-compatible chat API used by app/rag/generate.py
# Groq example: LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=llama-3.1-8b-instant
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

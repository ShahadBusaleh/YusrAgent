# Copy to .env and fill in. Never commit .env.

# --- Database -------------------------------------------------------------
SQLITE_PATH=agentic_hr.db

# --- Auth (JWT) -----------------------------------------------------------
# Use a long random value, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
# If unset or left as below, the API uses a random secret per restart (users get logged out).
JWT_SECRET=replace-with-a-long-random-string
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# --- Streamlit -> FastAPI -------------------------------------------------
API_BASE_URL=http://127.0.0.1:8000
# Browser origins allowed by CORS (comma-separated). The Streamlit UI calls the
# API server-side and doesn't need this.
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# --- Vector store (Qdrant) ------------------------------------------------
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=yusor_policies
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- LLM (any OpenAI-compatible chat API) ---------------------------------
# LLM_BASE_URL and LLM_MODEL must belong to the same provider.
# Groq example: LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
# Optional: several keys, comma-separated. Takes precedence over LLM_API_KEY;
# app/llm.py rotates them and fails over on 429. Keys only add capacity if
# each one belongs to a different organization.
LLM_API_KEYS=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

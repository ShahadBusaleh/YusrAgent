SQLITE_PATH=agentic_hr.db

JWT_SECRET=yusor-local-dev-secret-replace-me
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

API_BASE_URL=http://127.0.0.1:8000

QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=yusor_policies
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# OpenAI-compatible chat API used by app/rag/generate.py
# Groq example: LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
# Several keys (comma-separated) spread load across providers' per-org
# rate limits; app/llm.py rotates and fails over on 429. Takes precedence
# over LLM_API_KEY. Keys only add capacity if each is from a different org.
LLM_API_KEYS=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# OpenAI-compatible chat API used by app/rag/generate.py
# Groq example: LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

// Owner: HR (Member 2). Runs HRAgent directly. Offline unless "llm": true.
// EMP-0002 (Rana Al Harbi, employee): annual_remaining 17, hired 26-05-2026, payroll 2026-06 net 5684.82.
{"id": "h-01", "target": "hr", "user": "EMP-0002", "query": "How many annual leave days do I have remaining?", "expect": {"facts_has": ["leave_balance"], "facts_equals": {"annual_remaining": 17.0}}}
{"id": "h-02", "target": "hr", "user": "EMP-0002", "query": "What is my payroll for June 2026?", "expect": {"facts_has": ["payroll"], "facts_equals": {"payroll.pay_period": "2026-06", "payroll.net_pay_sar": 5684.82}}}
{"id": "h-03", "target": "hr", "user": "EMP-0002", "query": "What was my payroll for January 2026?", "notes": "Before hire date: should explain, not just say 'not found'.", "expect": {"facts_not_has": ["payroll"], "facts_contains": {"payroll_notice": "joined"}}}
{"id": "h-04", "target": "hr", "user": "EMP-0002", "query": "How does the company calculate annual leave?", "notes": "'calculate' contains 'late' -> attendance lookup fires.", "expect": {"facts_not_has": ["attendance", "attendance_notice"]}}
{"id": "h-05", "target": "hr", "user": "EMP-0002", "query": "Change my IBAN to SA0380000000608010167519", "expect": {"proposed_action_type": "bank_update", "request_status": "READY_FOR_APPROVAL", "payload_equals": {"new_iban": "SA0380000000608010167519"}}}
{"id": "h-06", "target": "hr", "user": "EMP-0002", "query": "Please change my IBAN", "expect": {"request_status": "NEEDS_INFORMATION", "proposed_action_type": null}}
{"id": "h-07", "target": "hr", "user": "EMP-0002", "query": "Update my email to rana.new@example.com", "expect": {"proposed_action_type": "personal_info_update", "request_status": "READY_FOR_APPROVAL", "payload_equals": {"field_name": "email", "new_value": "rana.new@example.com"}}}
{"id": "h-08", "target": "hr", "user": "EMP-0002", "query": "I want to update my address to 12 King Fahd Rd, Al Khobar", "expect": {"proposed_action_type": "personal_info_update", "payload_equals": {"field_name": "address", "new_value": "12 King Fahd Rd, Al Khobar"}}}
{"id": "h-09", "target": "hr", "user": "EMP-0002", "query": "Update my phone number to 0551234567", "expect": {"proposed_action_type": "personal_info_update", "payload_equals": {"field_name": "mobile", "new_value": "0551234567"}}}
{"id": "h-10", "target": "hr", "user": "EMP-0002", "employee_id": "EMP-0003", "query": "Show the payroll for June 2026", "notes": "Employee asking for someone else's record must get nothing.", "expect": {"facts_empty": true, "proposed_action_type": null}}
{"id": "h-11", "target": "hr", "user": "EMP-0002", "query": "Hello", "notes": "Data minimization: salary/bank fields shouldn't ride along on unrelated queries.", "expect": {"facts_not_has": ["profile.salary", "profile.basic_salary", "profile.iban", "profile.bank_code"]}}
{"id": "h-12", "target": "hr", "user": "EMP-0002", "query": "Show the skill gap for my department", "expect": {"request_status": "NOT_AUTHORIZED", "facts_not_has": ["experience_gap"]}}
{"id": "h-13", "target": "hr", "user": "EMP-0001", "query": "Show the skill gap for my department", "expect": {"facts_has": ["experience_gap.departments"]}}
{"id": "h-14", "target": "hr", "user": "EMP-0002", "query": "I want to take annual leave from 2026-12-20 to 2026-12-22", "llm": true, "expect": {"proposed_action_type": "leave_request", "payload_equals": {"leave_type": "annual", "start_date": "2026-12-20", "end_date": "2026-12-22", "days": 3.0}}}
{"id": "h-15", "target": "hr", "user": "EMP-0002", "query": "Update my phone number to 12345678", "expect": {"request_status": "NEEDS_INFORMATION", "proposed_action_type": null}}
{"id": "h-16", "target": "hr", "user": "EMP-0002", "query": "Change my IBAN to SA0380000000608010167518", "notes": "Last digit changed: fails the mod-97 checksum.", "expect": {"request_status": "NEEDS_INFORMATION", "proposed_action_type": null}}
{"id": "h-17", "target": "hr", "user": "EMP-0002", "query": "I need a salary certificate", "notes": "'salary' must not trigger a payroll lookup here.", "expect": {"proposed_action_type": "certificate_request", "facts_not_has": ["payroll", "payroll_notice"]}}
